---
// Shared page shell: head, preloaded fonts, styles and the JS flag used by the scroll reveals.
interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
  /** "/" for pages that can be shown at any depth (the 404 page); "" keeps links relative. */
  root?: string;
}
const { title, description, bodyClass, noindex = false, root = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#5E3A4C">
<slot name="head" />
<link rel="preload" href={root + "assets/fonts/anybody-latin.woff2"} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={root + "assets/fonts/figtree-latin.woff2"} as="font" type="font/woff2" crossorigin>
<link rel="icon" href={root + "assets/icon.svg"} type="image/svg+xml">
<link rel="stylesheet" href={root + "styles.css"}>
<script is:inline>document.documentElement.classList.add("js")</script>
</head>
<body class={bodyClass}>
<a class="skip" href="#main">Skip to content</a>
<slot />
</body>
</html>
