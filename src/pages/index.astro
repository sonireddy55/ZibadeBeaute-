---
// Home page. Services, deals, hours and gallery come from content/*.json (Pages CMS).
import Base from "../layouts/Base.astro";
import ServiceItem from "../components/ServiceItem.astro";
import GalleryItem from "../components/GalleryItem.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../lib/content.js";

const salon = (id, name, street, zip, lat, lng, extra = {}) => ({
  "@type": "BeautySalon", "@id": `https://zibadebeaute.com/#${id}`, name, url: "https://zibadebeaute.com/",
  telephone: "+1-352-328-4727", email: "zibasthreading@gmail.com", priceRange: site.priceRange,
  address: { "@type": "PostalAddress", streetAddress: street, addressLocality: "Gainesville", addressRegion: "FL", postalCode: zip, addressCountry: "US" },
  geo: { "@type": "GeoCoordinates", latitude: lat, longitude: lng },
  founder: { "@type": "Person", name: "Ziba Ahmadi" }, ...extra
});
const jsonLd = { "@context": "https://schema.org", "@graph": [
  salon("thornebrook", "Ziba de Beauté (Thornebrook)", "2441 NW 43rd St, Suite 7", "32606", 29.6757518, -82.3871539,
    { sameAs: ["https://www.instagram.com/ziba_de_beaute/", "https://www.facebook.com/zibathreading", "http://www.tiktok.com/@zibamagic", "https://www.yelp.com/biz/zibas-threading-gainesville"] }),
  salon("campus", "Ziba de Beauté (Campus)", "805 NW 13th St", "32601", 29.6595994, -82.338887)
] };
const hasGallery = site.gallery.length > 0;
---
<Base
  title="Ziba de Beauté | Eyebrow Threading in Gainesville, FL"
  description="Eyebrow threading and tinting by Ziba Ahmadi, Guinness World Record threader. Two Gainesville salons: Thornebrook (NW 43rd St) and Campus (NW 13th St). Book online or text (352) 328-4727."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://zibadebeaute.com/">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Ziba de Beauté">
    <meta property="og:title" content="Ziba de Beauté | Eyebrow Threading in Gainesville, FL">
    <meta property="og:description" content="Brows in about five minutes from a Guinness World Record threader. Two Gainesville locations.">
    <meta property="og:url" content="https://zibadebeaute.com/">
    <meta property="og:image" content={new URL("assets/record-crowd.webp", Astro.site ?? "https://zibadebeaute.com/").href}>
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

<header class="bar">
  <a class="wordmark" href="#top" aria-label="Ziba de Beauté, back to top">Ziba <span>de Beauté</span></a>
  <nav aria-label="Main">
    <ul>
      <li><a href="#services">Services</a></li>
      <li><a href="#ziba">About Ziba</a></li>
      {hasGallery && <li><a href="gallery.html">Gallery</a></li>}
      <li><a href="#reviews">Reviews</a></li>
      <li><a href="#visit">Locations</a></li>
    </ul>
  </nav>
  <a class="btn btn-small" href="book.html">Book</a>
</header>

<main id="main">

{/* HERO */}
<section class="hero" id="top" aria-labelledby="hero-title">
  <svg class="thread" viewBox="0 0 1200 260" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M-20 210 C 180 210, 300 60, 520 55 S 820 120, 900 150 S 1100 190, 1220 120" />
  </svg>
  <div class="hero-inner">
    <p class="hero-kicker">Eyebrow threading in Gainesville, Florida</p>
    <h1 id="hero-title">Your brows, done in about five minutes.</h1>
    <p class="hero-sub">Ziba Ahmadi is a Guinness World Record threader. She shapes with the thread alone, keeps brows full, and has two salons: one by UF campus and one at Thornebrook.</p>
    <div class="hero-actions">
      <a class="btn" href="#services">Choose a service and book</a>
      <a class="btn btn-ghost" href="sms:+13523284727">Text (352) 328-4727</a>
    </div>
    <p class="hero-note">{site.hours}. The phone line is text only.</p>
  </div>
</section>

{/* PROOF */}
<section class="proof" aria-label="Recognition">
  <ul>
    <li><strong>5.0 on Google</strong><span>2,441 reviews at the Campus salon</span></li>
    <li><strong>Guinness World Record</strong><span>Most eyebrows threaded in one hour</span></li>
    <li><strong>Small Business of the Year</strong><span>Gainesville Chamber, 2022</span></li>
  </ul>
</section>

{/* SERVICES */}
<section class="services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <h2 id="services-title">What do you need today?</h2>
    <div class="router" role="group" aria-label="Filter services">
      <button type="button" class="chip" aria-pressed="true" data-filter="all">Show everything</button>
      <button type="button" class="chip" aria-pressed="false" data-filter="brows">Just my brows</button>
      <button type="button" class="chip" aria-pressed="false" data-filter="plus">Brows and a little more</button>
      <button type="button" class="chip" aria-pressed="false" data-filter="face">My whole face</button>
      <button type="button" class="chip" aria-pressed="false" data-filter="spot">One spot</button>
    </div>
    <p class="services-help">Every price is per visit. After you tap Book, you pick the salon and a time that works.</p>

    <ul class="menu" id="menu">
      {site.services.map((s) => <ServiceItem s={s} />)}
    </ul>
  </div>
</section>

{site.deals.length > 0 && (
<section class="deals" aria-labelledby="deals-title">
  <div class="wrap">
    <h2 id="deals-title">Monthly deal days</h2>
    <p>A little treat goes a long way. {site.dealsIntro}</p>
    <ul class="deal-list">
      {site.deals.map((s) => <li><strong>{s.name}, ${s.deal.price}</strong><span>{s.deal.when}</span><span class="next" data-nth={s.deal.nth} data-dow={s.deal.dow}></span></li>)}
    </ul>
  </div>
</section>
)}

{/* ABOUT */}
<section class="about" id="ziba" aria-labelledby="ziba-title">
  <div class="wrap about-grid">
    <figure class="portrait">
      <img src="assets/ziba-portrait.webp" width="486" height="529" alt="Ziba Ahmadi, owner of Ziba de Beauté" loading="lazy" decoding="async">
    </figure>
    <div>
      <h2 id="ziba-title">Meet Ziba</h2>
      <p>Ziba is a World Record Threader. Through her many years of experience she has become widely known across Florida as the best. She keeps providing her service to customers across the state and keeps branching out to new places where she is needed, and her hard work has earned her a loyal following.</p>
      <p>She shapes the arch with the thread itself, not tweezers, and keeps brows full and natural.</p>
      <ul class="facts">
        <li>Guinness World Record: most eyebrows threaded in one hour</li>
        <li>Gainesville Chamber Small Business of the Year, 2022</li>
        <li>Threads at UF sorority houses on campus</li>
      </ul>
    </div>
  </div>
  <div class="wrap records">
    <img src="assets/record-certificate.webp" width="600" height="921" alt="Ziba's Guinness World Records certificate for most eyebrows threaded in one hour" loading="lazy" decoding="async">
    <img src="assets/record-recognition.webp" width="600" height="817" alt="Greater Gainesville Chamber Business Awards 2022: Small Business of the Year, Salon Ziba" loading="lazy" decoding="async">
    <img src="assets/record-event.webp" width="600" height="764" alt="Ziba holding her Guinness certificate in her salon" loading="lazy" decoding="async">
    <img src="assets/record-crowd.webp" width="900" height="665" alt="Group picture from Ziba's Guinness World Record event, June 16, 2021" loading="lazy" decoding="async">
  </div>
</section>

{hasGallery && (
<section class="teaser" aria-labelledby="teaser-title">
  <div class="wrap">
    <h2 id="teaser-title">Ziba's work</h2>
    <ul class="gallery-grid">
      {site.gallery.slice(0, 3).map((g, i) => <GalleryItem g={g} index={i} />)}
    </ul>
    <a class="teaser-link" href="gallery.html">See the full gallery</a>
  </div>
</section>
)}

{/* PRESS */}
<section class="press" aria-labelledby="press-title">
  <div class="wrap">
    <h2 id="press-title">In the news</h2>
    <ul class="press-list">
      <li><a href="https://www.mainstreetdailynews.com/business/gnv-chamber-holds-business-awards"><span class="yr">2022</span>Salon Ziba wins Small Business of the Year from the Gainesville Chamber<span class="src">Mainstreet Daily News</span></a></li>
      <li><a href="https://dailyfloridapress.com/that-was-amazing-gainesville-eyebrow-threader-breaks-her-own-guinness-world-record/"><span class="yr">2022</span>Gainesville eyebrow threader breaks her own Guinness World Record<span class="src">Daily Florida Press</span></a></li>
      <li><a href="https://www.mainstreetdailynews.com/local_living/local-salon-owner-sets-world-record/article_d317d3de-b0ff-11ec-8170-c71dbbe1ed78.html"><span class="yr">2022</span>Local salon owner sets world record<span class="src">Mainstreet Daily News</span></a></li>
      <li><a href="https://issuu.com/towerpublications/docs/otgv_2022-issue_4-july-aug/48"><span class="yr">2022</span>Feature in Our Town magazine, July–August issue<span class="src">Our Town</span></a></li>
      <li><a href="https://www.alligator.org/article/2021/06/gainesville-salon-breaks-guinness-world-record-for-most-eyebrows-threaded"><span class="yr">2021</span>Gainesville salon breaks Guinness World Record for most eyebrows threaded<span class="src">The Independent Florida Alligator</span></a></li>
    </ul>

    <div class="film">
      <h3>The documentary UF made about Ziba</h3>
      <button type="button" class="film-play" data-video="ZxJ88LFe0Ps" aria-label="Play the documentary about Ziba on YouTube">
        <img src="https://i.ytimg.com/vi/ZxJ88LFe0Ps/hqdefault.jpg" width="480" height="360" alt="" loading="lazy" decoding="async">
        <span class="play" aria-hidden="true"></span>
      </button>
      <p><a href="https://www.youtube.com/watch?v=ZxJ88LFe0Ps">Watch on YouTube</a> or see more on <a href="https://www.youtube.com/channel/UCE4c3jP_mOveB4b4cFhfhWQ">Ziba's channel</a>.</p>
    </div>
  </div>
</section>

{/* REVIEWS */}
<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <h2 id="reviews-title">What clients say</h2>
    <p class="reviews-sum">Both salons are rated 5.0 on Google. <a href="https://tinyurl.com/3whmtsfz">Read the Google reviews</a> or <a href="https://www.yelp.com/biz/zibas-threading-gainesville">read them on Yelp</a>.</p>
  </div>
  <div class="ticker" tabindex="0" aria-label="Client reviews from Yelp. Scroll sideways to read more.">
    <ul>
      <li><blockquote>The fastest and best eyebrows I've ever had! I love Ziba, she always is so kind.</blockquote><cite>Isabella W., Yelp, 2024</cite></li>
      <li><blockquote>Appointment was for 5 minutes and she got mine down in 2.5 minutes after not having them done for months.</blockquote><cite>Kailyn H., Yelp, 2022</cite></li>
      <li><blockquote>Ziba is a treasure. Fun, kind, very good at what she does. She even has a Guinness Record!</blockquote><cite>A G., Yelp, 2022</cite></li>
      <li><blockquote>I hadn't trusted anyone with my brows for 7 years until I met Ziba. My brows have never looked better.</blockquote><cite>Anna Lauren W., Yelp, 2021</cite></li>
      <li><blockquote>Ziba is so fast! Literally under 5 minutes. Incredible customer service.</blockquote><cite>Michelle S., Yelp, 2021</cite></li>
      <li><blockquote>She shapes them beautifully and there is no pain at all. Ziba keeps them thick, natural looking and perfectly shaped.</blockquote><cite>Sarah F., Yelp, 2017</cite></li>
      <li><blockquote>Ziba's hands are so light and I can barely feel it. Be sure to make an appointment.</blockquote><cite>Mina G., Yelp, 2017</cite></li>
      <li><blockquote>Whenever she comes to my sorority house, the appointment spots are gone within minutes.</blockquote><cite>Claire W., Yelp, 2016</cite></li>
    </ul>
  </div>
</section>

{/* VISIT */}
<section class="visit" id="visit" aria-labelledby="visit-title">
  <div class="wrap">
    <h2 id="visit-title">Two salons in Gainesville</h2>
    <div class="locs">
      <article class="loc">
        <h3>Campus</h3>
        <p class="addr">805 NW 13th St<br>Gainesville, FL 32601</p>
        <p><a href="https://maps.google.com/?q=805+NW+13th+St,+Gainesville,+FL+32601">Get directions</a></p>
      </article>
      <article class="loc">
        <h3>Thornebrook</h3>
        <p class="addr">2441 NW 43rd St, <strong>Suite 7</strong><br>Gainesville, FL 32606</p>
        <p class="loc-note">Look for Suite 7 in Thornebrook Village.</p>
        <p><a href="https://maps.google.com/?q=2441+NW+43rd+St+Suite+7,+Gainesville,+FL+32606">Get directions</a></p>
      </article>
    </div>
    <dl class="info">
      <div><dt>Hours</dt><dd>{site.hours}</dd></div>
      <div><dt>Book</dt><dd><a href="book.html">Book online</a>, or by text</dd></div>
      <div><dt>Text</dt><dd><a href="sms:+13523284727">(352) 328-4727</a> (text only, no calls)</dd></div>
      <div><dt>Email</dt><dd><a href="mailto:zibasthreading@gmail.com">zibasthreading@gmail.com</a></dd></div>
      <div><dt>Pay</dt><dd><a href="https://venmo.com/code?user_id=1794322101960704048&amp;created=1662307942">Venmo</a></dd></div>
    </dl>
  </div>
</section>

</main>

<SiteFooter full />

<a class="dock" href="book.html">Book a service</a>

<script is:inline src="main.js" defer></script>
{hasGallery && <script is:inline src="gallery.js" defer></script>}
</Base>
